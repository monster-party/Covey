{
  "name": "covey-calendar",
  "version": "0.11.1",
  "private": false,
  "type": "module",
  "scripts": {
    "setup": "node setup.js",
    "start": "node start.js",
    "dev": "concurrently --kill-others --names server,web --prefix-colors blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch --env-file=.env server-entry.js",
    "dev:web": "vite --host 0.0.0.0",
    "build:web": "vite build",
    "build:server": "npm run build:web && node scripts/build-server-artifact.js",
    "build:macos": "npm run build:server && node scripts/build-macos-app.js",
    "verify:server": "node scripts/verify-server-artifact.js",
    "test": "node --test"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "express": "^5.2.1",
    "ical.js": "^2.2.1",
    "tsdav": "^2.3.4"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "vite": "^8.3.4"
  }
}
